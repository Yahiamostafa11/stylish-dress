APP_ENV=production
APP_DEBUG=false
APP_URL=https://l.styliiiish.com
APP_KEY=    

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=    
DB_USERNAME=    
DB_PASSWORD=    

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GA4_MEASUREMENT_ID=
GOOGLE_ADS_TAG_ID=

# Public base URL of the WordPress/WooCommerce site (see config/styliiiish.php).
WP_PUBLIC_URL=https://l.styliiiish.com
BLOG_SINGLE_CACHE_MINUTES=15
BLOG_SINGLE_REMOTE_SCRAPE=false

# New listings go to real 'pending' moderation — approve from wp-admin.
# Only set true for a throwaway demo where wp-admin can't be reached.
AMNAHI_AUTO_PUBLISH=false

# React storefront's own public URL — used to build links back into it from
# emails (e.g. the seller-interest notification).
FRONTEND_URL=https://styliiiish.com

# Checkout -> WooCommerce order creation (see wc-order-bridge.php in the
# WordPress webroot). WC_ORDER_BRIDGE_SECRET must match the
# STYLIIISH_ORDER_BRIDGE_SECRET constant defined in wp-config.php on the
# WordPress side — generate a random 64-char value and set it in BOTH places.
WC_API_URL=https://l.styliiiish.com
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
WC_ORDER_BRIDGE_SECRET=
