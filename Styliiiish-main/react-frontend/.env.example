# Laravel API base URL the React app calls (see src/api/client.js).
# Without this set, the app falls back to http://127.0.0.1:8000/api — fine for
# local dev, but MUST be set to the real deployed API URL before building for
# production, or the live site will try to call localhost from users' browsers.
VITE_API_BASE=https://l.styliiiish.com/api
